{
    "name": "hiradumi",
    "version": "1.6.10",
    "description": "アスペクト比を維持して幅ぴったりにレイアウトするReactコンポーネント",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "src/index.d.ts",
    "files": [
        "lib",
        "src"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CALIL/hiradumi.git"
    },
    "author": "CALIL Inc.",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CALIL/hiradumi/issues"
    },
    "homepage": "https://github.com/CALIL/hiradumi#readme",
    "scripts": {
        "start": "vite --open",
        "build": "vite build --config ./vite.config.build.mts",
        "serve": "vite preview",
        "typecheck": "tsc --noEmit",
        "compile": "vite build --config ./vite.config.lib.mts",
        "prepublishOnly": "npm run typecheck && npm run compile"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "react-window": "^2.2.7",
        "sass": "^1.102.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.0"
    }
}
