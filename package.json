{
  "name": "@calil/hiradumi",
  "private": true,
  "version": "2.0.0",
  "description": "Web Components for Layouting Book Images",
  "author": "Satoshi Deguchi <deguchi@calil.jp>",
  "license": "MIT",
  "main": "dist/hiradumi.bundle.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "start": "vite --open --host",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --disable-console-intercept",
    "coverage": "vitest run --coverage",
    "publosh": "npm login && npm publish --access public",
    "publish:patch": "npm version patch && npm publish --access public"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "react-to-webcomponent": "^2.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.3"
  },
  "keywords": [
    "web-component",
    "hiradumi",
    "book image",
    "npm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CALIL/hiradumi.git"
  },
  "homepage": "https://github.com/CALIL/hiradumi#readme"
}
