{
  "name": "@calil/hiradumi",
  "private": false,
  "version": "2.0.0",
  "description": "Web Components for Layouting Book Images",
  "author": "Satoshi Deguchi <deguchi@calil.jp>",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "start": "vite --open --host",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --disable-console-intercept",
    "coverage": "vitest run --coverage",
    "publish": "npm login && npm publish --access public",
    "publish:patch": "npm version patch && npm publish --access public"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "react": "^^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "react-to-webcomponent": "^2.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.3"
  },
  "keywords": [
    "react",
    "react-component",
    "hiradumi",
    "book-image",
    "grid-layout",
    "virtual-scroll"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CALIL/hiradumi.git"
  },
  "homepage": "https://github.com/CALIL/hiradumi#readme"
}
